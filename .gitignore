# ── Python build artifacts ──────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
.installed.cfg
# Note: removed `lib/` rule — we ship lib/ as a Python package (see step1_6 plan §4.1).
# venv-internal lib/ is still ignored because .venv/ / .venv_*/ / venv/ are blanket-ignored below.
lib64/

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
.venv_*/
venv/
env/
ENV/

# ── Tokenizer / model weights (download separately, never commit) ───────────
models/

# ── Test & coverage ──────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.prof
*.prof.svg

# ── Type / lint caches ───────────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.dmypy.json

# ── Simulation outputs (generated, never commit) ─────────────────────────────
outputs/
results/
artifacts/

# ── Trace data (may contain production / private data) ───────────────────────
# Keep data/.gitkeep so the directory is tracked.
data/**
!data/.gitkeep
!data/README.md

# Explicit trace file extensions (belt-and-suspenders)
*.csv
*.jsonl
*.parquet
*.arrow
*.tsv
# Exception: small fixture files committed to tests/
!tests/fixtures/*.csv
!tests/fixtures/*.jsonl

# ── Offline registry output ───────────────────────────────────────────────────
*.txt
# Exception: keep committed docs / requirements
!requirements*.txt
!*.rst
!docs/*.txt

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.*
*.key
*.pem
secrets/

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
